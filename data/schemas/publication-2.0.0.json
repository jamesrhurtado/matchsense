        "window_end_ms": {
          "minimum": 0,
          "title": "Window End Ms",
          "type": "integer"
        },
        "input_cutoff_ms": {
          "minimum": 0,
          "title": "Input Cutoff Ms",
          "type": "integer"
        },
        "coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Coverage",
          "type": "number"
        },
        "qualification": {
          "title": "Qualification",
          "type": "string"
        }
