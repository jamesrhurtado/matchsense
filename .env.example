WHY_NOW_PRODUCER_TOKEN=local-demo-producer
WHY_NOW_DB=./why_now.db
# Server-side Next.js proxy destination; never exposed as a browser credential.
API_URL=http://127.0.0.1:8000
WHY_NOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional cloud adapters; infra/deploy_apps.py sets actual server values.
# WHY_NOW_ENVIRONMENT=azure
# WHY_NOW_MODEL_MODE=foundry
# WHY_NOW_AZURE_ENVIRONMENT=production
# AZURE_CLIENT_ID=<managed-identity-client-id>
# AZURE_OPENAI_ENDPOINT=https://<account>.openai.azure.com/
# FOUNDRY_MODEL_DEPLOYMENT=story-model
# WHY_NOW_COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
# WHY_NOW_COSMOS_DATABASE=whynow
# WHY_NOW_EVENTHUB_NAMESPACE=<namespace>.servicebus.windows.net
# WHY_NOW_EVENTHUB_NAME=match-observations
# WHY_NOW_EVENTHUB_CONSUMER_GROUP=whynow-state
# WHY_NOW_CHECKPOINT_ACCOUNT_URL=https://<account>.blob.core.windows.net
# WHY_NOW_CHECKPOINT_CONTAINER=eventhub-checkpoints
# APPLICATIONINSIGHTS_CONNECTION_STRING=<workspace-linked-component-connection>
