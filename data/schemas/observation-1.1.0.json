    "EventObservation": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "match_id": {
          "title": "Match Id",
          "type": "string"
        },
        "message_id": {
          "title": "Message Id",
          "type": "string"
        },
        "sequence_no": {
          "minimum": 0,
          "title": "Sequence No",
          "type": "integer"
        },
        "timeline_ms": {
          "minimum": 0,
          "title": "Timeline Ms",
          "type": "integer"
        },
        "period": {
          "minimum": 1,
          "title": "Period",
          "type": "integer"
        },
        "period_elapsed_ms": {
          "minimum": 0,
          "title": "Period Elapsed Ms",
          "type": "integer"
        },
        "available_at_ms": {
          "minimum": 0,
          "title": "Available At Ms",
          "type": "integer"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "supersedes_message_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Supersedes Message Id"
        },
        "kind": {
          "const": "event",
          "title": "Kind",
          "type": "string"
        },
        "payload": {
          "discriminator": {
            "mapping": {
              "ball_recovered": "#/$defs/BallRecovered",
              "goal_status_changed": "#/$defs/GoalStatusChanged",
              "pass_resolved": "#/$defs/PassResolved",
              "pass_started": "#/$defs/PassStarted",
              "period_state_changed": "#/$defs/PeriodStateChanged",
              "play_state_changed": "#/$defs/PlayStateChanged",
              "possession_changed": "#/$defs/PossessionChanged",
              "shot_resolved": "#/$defs/ShotResolved",
              "shot_started": "#/$defs/ShotStarted"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PassStarted"
            },
            {
              "$ref": "#/$defs/PassResolved"
            },
            {
              "$ref": "#/$defs/PossessionChanged"
            },
            {
              "$ref": "#/$defs/PlayStateChanged"
            },
            {
              "$ref": "#/$defs/ShotStarted"
            },
            {
              "$ref": "#/$defs/ShotResolved"
            },
            {
              "$ref": "#/$defs/GoalStatusChanged"
            },
            {
              "$ref": "#/$defs/BallRecovered"
            },
            {
              "$ref": "#/$defs/PeriodStateChanged"
            }
          ],
          "title": "Payload"
        }
      },
      "required": [
        "schema_version",
        "match_id",
        "message_id",
        "sequence_no",
        "timeline_ms",
        "period",
        "period_elapsed_ms",
        "available_at_ms",
        "revision",
        "supersedes_message_id",
        "kind",
        "payload"
      ],
      "title": "EventObservation",
      "type": "object"
    },
