{
  "$defs": {
    "AudienceVariant": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "language": {
          "enum": [
            "en",
            "es"
          ],
          "title": "Language",
          "type": "string"
        },
        "detail": {
          "enum": [
            "simple",
            "detail"
          ],
          "title": "Detail",
          "type": "string"
        },
        "focus": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Focus"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "claim_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Claim Ids",
          "type": "array"
        },
        "factual_check_status": {
          "const": "valid",
          "title": "Factual Check Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "language",
        "detail",
        "focus",
        "text",
        "claim_ids",
        "factual_check_status"
      ],
      "title": "AudienceVariant",
      "type": "object"
    },
    "EventClaim": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "c-event",
          "default": "c-event",
          "title": "Id",
          "type": "string"
        },
        "predicate": {
          "enum": [
            "shot_outcome",
            "confirmed_goal",
            "control_transition",
            "possession_interval",
            "pressure_swing"
          ],
          "title": "Predicate",
          "type": "string"
        },
        "value": {
          "additionalProperties": true,
          "title": "Value",
          "type": "object"
        },
        "unit": {
          "const": "observation",
          "default": "observation",
          "title": "Unit",
          "type": "string"
        },
        "evidence_revision": {
          "title": "Evidence Revision",
          "type": "string"
        },
        "source_message_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Message Ids",
          "type": "array"
        }
      },
      "required": [
        "predicate",
        "value",
        "evidence_revision",
        "source_message_ids"
      ],
      "title": "EventClaim",
      "type": "object"
    },
    "EventEvidence": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "enum": [
            "shot",
            "goal",
            "recovery",
            "possession",
            "pressure"
          ],
          "title": "Family",
          "type": "string"
        },
        "subject_id": {
          "title": "Subject Id",
          "type": "string"
        },
        "incident_id": {
          "title": "Incident Id",
          "type": "string"
        },
        "team_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Team Id"
        },
        "participants": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Participants",
          "type": "object"
        },
        "occurrence_ms": {
          "minimum": 0,
          "title": "Occurrence Ms",
          "type": "integer"
        },
        "evidence_ready_ms": {
          "minimum": 0,
          "title": "Evidence Ready Ms",
          "type": "integer"
        },
        "input_cutoff_ms": {
          "minimum": 0,
          "title": "Input Cutoff Ms",
          "type": "integer"
        },
        "window_start_ms": {
          "minimum": 0,
          "title": "Window Start Ms",
          "type": "integer"
        },
        "window_end_ms": {
          "minimum": 0,
          "title": "Window End Ms",
          "type": "integer"
        },
        "source_message_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Message Ids",
          "type": "array"
        },
        "source_hashes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Hashes",
          "type": "array"
        },
        "facts": {
          "additionalProperties": true,
          "title": "Facts",
          "type": "object"
        },
        "eligible": {
          "const": true,
          "title": "Eligible",
          "type": "boolean"
        },
        "definition_version": {
          "enum": [
            "match-events-v1",
            "nearby-pressure-swing-v1"
          ],
          "title": "Definition Version",
          "type": "string"
        },
        "expires_at_ms": {
          "minimum": 0,
          "title": "Expires At Ms",
          "type": "integer"
        },
        "evidence_revision": {
          "pattern": "^[a-f0-9]{16}$",
          "title": "Evidence Revision",
          "type": "string"
        }
      },
      "required": [
        "family",
        "subject_id",
        "incident_id",
        "team_id",
        "participants",
        "occurrence_ms",
        "evidence_ready_ms",
        "input_cutoff_ms",
        "window_start_ms",
        "window_end_ms",
        "source_message_ids",
        "source_hashes",
        "facts",
        "eligible",
        "definition_version",
        "expires_at_ms",
        "evidence_revision"
      ],
      "title": "EventEvidence",
      "type": "object"
    },
    "ModelUsage": {
      "additionalProperties": false,
      "properties": {
        "calls": {
          "minimum": 0,
          "title": "Calls",
          "type": "integer"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "total_tokens": {
          "minimum": 0,
          "title": "Total Tokens",
          "type": "integer"
        },
        "usage_complete": {
          "title": "Usage Complete",
          "type": "boolean"
        }
      },
      "required": [
        "calls",
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "usage_complete"
      ],
      "title": "ModelUsage",
      "type": "object"
    },
    "ReviewDecision": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "supported",
            "revised"
          ],
          "title": "Status",
          "type": "string"
        },
        "mode": {
          "enum": [
            "deterministic_template",
            "foundry",
            "template_fallback"
          ],
          "title": "Mode",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "proposed_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Proposed Text"
        },
        "revised_text": {
          "title": "Revised Text",
          "type": "string"
        },
        "cycles": {
          "maximum": 1,
          "minimum": 0,
          "title": "Cycles",
          "type": "integer"
        }
      },
      "required": [
        "status",
        "mode",
        "reason",
        "proposed_text",
        "revised_text",
        "cycles"
      ],
      "title": "ReviewDecision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "7.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "family": {
      "const": "pressure",
      "title": "Family",
      "type": "string"
    },
    "incident_id": {
      "title": "Incident Id",
      "type": "string"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/EventClaim"
      },
      "maxItems": 1,
      "minItems": 1,
      "title": "Claims",
      "type": "array"
    },
    "metrics": {
      "$ref": "#/$defs/EventEvidence"
    },
    "variants": {
      "items": {
        "$ref": "#/$defs/AudienceVariant"
      },
      "title": "Variants",
      "type": "array"
    },
    "review": {
      "$ref": "#/$defs/ReviewDecision"
    },
    "evidence_revision": {
      "title": "Evidence Revision",
      "type": "string"
    },
    "eligible_from_ms": {
      "minimum": 0,
      "title": "Eligible From Ms",
      "type": "integer"
    },
    "expires_at_ms": {
      "minimum": 0,
      "title": "Expires At Ms",
      "type": "integer"
    },
    "trace": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Trace",
      "type": "array"
    },
    "workflow_ms": {
      "minimum": 0,
      "title": "Workflow Ms",
      "type": "number"
    },
    "mode": {
      "enum": [
        "local deterministic template",
        "template fallback",
        "Microsoft Agent Framework + Azure OpenAI"
      ],
      "title": "Mode",
      "type": "string"
    },
    "model_usage": {
      "$ref": "#/$defs/ModelUsage"
    },
    "renderer_version": {
      "const": "pressure-swing-v7",
      "title": "Renderer Version",
      "type": "string"
    },
    "entities": {
      "additionalProperties": true,
      "title": "Entities",
      "type": "object"
    },
    "package_hash": {
      "title": "Package Hash",
      "type": "string"
    }
  },
  "required": [
    "id",
    "revision",
    "title",
    "family",
    "incident_id",
    "claims",
    "metrics",
    "variants",
    "review",
    "evidence_revision",
    "eligible_from_ms",
    "expires_at_ms",
    "trace",
    "workflow_ms",
    "mode",
    "model_usage",
    "entities",
    "package_hash"
  ],
  "title": "EventPackage",
  "type": "object"
}
